# Postgres connection string (Neon via the Vercel Marketplace in production).
DATABASE_URL=postgres://user:password@localhost:5432/alex

# Public URL of the app, no trailing slash. Production: https://alex.ericandeva.com
APP_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console > Google Auth Platform > Clients, type "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated Google account emails allowed to sign in to Alex.
ALEX_ALLOWED_EMAILS=

# 32-byte key, base64-encoded, used to encrypt stored OAuth tokens. Generate with: npm run gen:key
# Changing it makes every stored token unreadable (you would reconnect each account).
ALEX_ENCRYPTION_KEY=

# "true" while the Google OAuth app is in Testing status: refresh tokens expire after 7 days,
# so Alex shows a reconnect-by date for each account. "false" once the app is published
# (docs/SETUP.md section 13). Unset means "true", so set it to "false" explicitly.
GOOGLE_OAUTH_TESTING_MODE=true

# --- Mail ingestion (Phase 2a). All optional; see docs/SETUP.md section 6. ---
# Pub/Sub topic Gmail publishes new-mail notifications to, e.g. projects/<project-id>/topics/gmail-push.
# Leave empty for polling only (local development).
GMAIL_PUBSUB_TOPIC=
# Audience set on the Pub/Sub push subscription: the push endpoint URL, e.g. https://<your-domain>/api/gmail/push.
# Empty: the push endpoint answers 503.
PUBSUB_PUSH_AUDIENCE=
# Service account the push subscription authenticates as, e.g. <name>@<project-id>.iam.gserviceaccount.com.
# Empty: the push endpoint answers 503.
PUBSUB_PUSH_SERVICE_ACCOUNT=
# Bearer secret for the cron endpoints (Vercel Cron sends it). Letters and digits, at least 16 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# --- AI (Phase 2c). All optional; see docs/SETUP.md section 11. ---
# Claude API key from the Anthropic Console. Empty: AI triage and drafts are off ("AI not configured").
# Server-only: never commit a real key or paste it anywhere.
ANTHROPIC_API_KEY=
# Triage provider; empty means anthropic-haiku. Any other value turns triage off.
AI_TRIAGE_PROVIDER=
# Daily caps (UTC day). Empty means the defaults: triage 400 calls and $0.50, drafts 25 calls and $3.00, $3.50 overall.
AI_TRIAGE_MAX_CALLS_PER_DAY=
AI_TRIAGE_MAX_USD_PER_DAY=
AI_DRAFT_MAX_CALLS_PER_DAY=
AI_DRAFT_MAX_USD_PER_DAY=
AI_MAX_USD_PER_DAY=

# --- Compose (Phase 2d). Optional; see docs/SETUP.md section 12.2. ---
# First-time recipients (addresses Alex has not seen in your mail) you can approve per UTC day,
# across new emails and replies. Empty means 10; 0 means none; an invalid value means 10.
EMAIL_NEW_RECIPIENTS_PER_DAY=
